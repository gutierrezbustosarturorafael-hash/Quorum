PORT=5000
MONGODB_URI=mongodb://localhost:27017/sistema_gestion
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=1
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
JWT_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# HTTPS/TLS: configura ambos archivos para terminar TLS directamente en Node.
# Si un proxy o túnel termina TLS, deja las rutas vacías y confía solo el número
# de proxies conocidos. Activa FORCE_HTTPS en producción para redirigir HTTP.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
TRUST_PROXY_HOPS=0
FORCE_HTTPS=false
HTTPS_PUBLIC_ORIGIN=

# Clave aleatoria de 32 bytes (hex) para cifrar las contraseñas SMTP guardadas por empresa.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key

# Clave secreta de un solo uso para que una cuenta empresarial existente reclame la administración.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_BOOTSTRAP_KEY=replace-with-a-random-64-character-hex-key

# La verificación fiscal se realiza manualmente desde el panel administrativo.
